# SubSync Root Environment Template
# For local evaluation, default zero-config works out of the box (SQLite + Vite proxy).

# Backend configuration (optional overrides)
DJANGO_SECRET_KEY=dev-only-change-me-subsync-hackathon
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173

# Optional PostgreSQL configuration (if omitted, uses SQLite backend/db.sqlite3)
# POSTGRES_DB=subsync
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional SMTP configuration for email delivery
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=billing@brightloop.in
# EMAIL_HOST_PASSWORD=app-specific-password

# Frontend configuration (frontend/.env)
# Set VITE_USE_API=true to connect to Django REST API (default)
# Set VITE_USE_API=false for standalone offline demo mode
VITE_USE_API=true
