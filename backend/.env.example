# SubSync Backend Environment Template
DJANGO_SECRET_KEY=dev-only-change-me-subsync-hackathon
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173

# Optional: PostgreSQL Database (leave commented to use SQLite backend/db.sqlite3)
# POSTGRES_DB=subsync
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional: SMTP Email Delivery (console backend is used by default)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=billing@brightloop.in
# EMAIL_HOST_PASSWORD=app-specific-password
